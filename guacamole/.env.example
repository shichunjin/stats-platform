# ============================================================
# Guacamole 环境变量模板
# 使用方法：cp .env.example .env 并填入真实值
# 注意：.env 已被 .gitignore 排除，切勿提交到 git
# ============================================================

# ---- 必填：PostgreSQL 密码（与宿主机 guacamole_user 账号一致） ----
POSTGRES_PASSWORD=change_me_strong_password

# ---- 数据库连接：宿主机 PostgreSQL，独立 database guacamole_db ----
# 容器内访问宿主机用 host.docker.internal（compose 已配 extra_hosts: host-gateway）
POSTGRESQL_HOSTNAME=host.docker.internal
POSTGRESQL_PORT=5432
POSTGRESQL_DATABASE=guacamole_db
POSTGRESQL_USER=guacamole_user
