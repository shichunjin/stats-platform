# ============================================================
# Guacamole 环境变量模板
# 使用方法：cp .env.example .env 并填入真实值
# 注意：.env 已被 .gitignore 排除，切勿提交到 git
# ============================================================

# ---- 必填：PostgreSQL 数据库密码（Guacamole JDBC 认证） ----
POSTGRES_PASSWORD=change_me_strong_password
