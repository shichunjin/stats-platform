# ============================================================
# Guacamole 环境变量模板
# 使用方法：cp .env.example .env 并填入真实密码
# 注意：.env 已被 .gitignore 排除，切勿提交到 git
# ============================================================

# ---- Guacamole 门户登录密码（用户通过浏览器登录 Guacamole 时使用） ----
GUAC_USER1_PASSWORD=guacUser1Test
GUAC_ADMIN_PASSWORD=guacAdminTest

# ---- Windows 云主机 RDP 本地账户密码 ----
# 对应 Windows 云主机上用 setup-rdsh.ps1 创建的本地账户密码
RDP_USER1_PASSWORD=RDPUser1Test
RDP_ADMIN_PASSWORD=RDPAdminTest
