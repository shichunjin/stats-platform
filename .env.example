# ============================================================
# 环境变量配置模板
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿提交到 git
# ============================================================

# ---- 必填（隐私配置，无默认值，缺失会导致启动失败） ----

# 数据库连接串（含密码）
# 示例（PostgreSQL）：postgresql+psycopg2://stats:你的数据库密码@localhost:5432/stats_platform
# 示例（本地开发 SQLite）：sqlite:///./stats_platform.db
DATABASE_URL=postgresql+psycopg2://stats:CHANGE_ME_DB_PASSWORD@localhost:5432/stats_platform

# JWT 签名密钥（请使用足够长的随机字符串）
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_JWT_SECRET

# ---- 可选（以下均有默认值，需要时可覆盖） ----

# 演示账号密码（留空则禁用对应演示账号登录；生产环境建议留空并改用注册账号）
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# JWT 算法
JWT_ALGORITHM=HS256

# Token 有效期（小时）
JWT_EXPIRE_HOURS=8

# 文件服务器根路径（后端可写目录；生产环境改为挂载到 Windows 文件服务器的本地路径）
FILESERVER_ROOT=./fileserver_data

# 待导入的原始数据集 CSV 路径
DATASET_CSV_PATH=testData.csv

# 数据集名称（导入数据库后的标识）
DATASET_NAME=testData

# 远程桌面服务器地址与端口
RDS_HOST=8.133.223.251
RDS_PORT=3389

# Guacamole 前端地址
GUACAMOLE_URL=http://47.117.171.130:8080/guacamole/#/client/

# 兜底共享 RDP 连接 ID：仅在未配置 GUAC_DB_URL（旧 user-mapping 部署）时使用。
# 启用 JDBC 同步后，每个用户使用注册时自动创建的专属连接，此项不再生效。
GUACAMOLE_CONNECTION_ID=1

# Guacamole JDBC 认证数据库连接串（guacamole-auth-jdbc 使用的数据库）
# 配置后：注册时同步创建 Guacamole 用户（同密码）及其“一人一连接”的专属 RDP 连接，
# 修改密码时两边同步更新；留空则不同步（本地开发/测试）。
# 示例（PostgreSQL）：postgresql+psycopg2://guacamole_user:密码@127.0.0.1:5433/guacamole_db
# 示例（MySQL）：mysql+pymysql://guac_user:密码@localhost:3306/guacamole_db
GUAC_DB_URL=

# ---- 一人一专属 RDP 连接（配置 GUAC_DB_URL 后生效） ----
# 专属连接名前缀，完整连接名 = 前缀 + 用户名
GUAC_CONNECTION_PREFIX=windows-
# 把账号密码写入连接参数实现 RDP 自动登录（要求 Windows 账号与平台账号同名同密码；
# 设为 false 则用户连接时需手输 Windows 凭据）
GUAC_RDP_AUTO_LOGIN=true
# Windows 域名（工作组环境留空）
GUAC_RDP_DOMAIN=
# RDP 安全层：nla / tls / rdp；留空让 guacd 自动协商
GUAC_RDP_SECURITY=nla
# 忽略 RDP 证书错误（自签证书/按 IP 直连环境建议 true）
GUAC_RDP_IGNORE_CERT=true
# guacd 容器内 RDP 虚拟盘根目录（浏览器向远程会话传文件），按用户名建子目录隔离；留空不启用
GUAC_DRIVE_ROOT=
# guacd 容器内会话录像根目录，按用户名建子目录隔离；留空不录像
GUAC_RECORDING_ROOT=

# 各统计软件在 Windows Server 上的安装路径
RSTUDIO_PATH=C:\Program Files\RStudio\rstudio.exe
MPLUS_PATH=C:\Program Files\Mplus Demo\Mpdwin.exe
STATA_PATH=C:\Program Files\Stata18\StataSE-64.exe

# PowerShell 登录脚本路径
PS_LOGIN_SCRIPT=\\fileserver\scripts\login.ps1

# ---- Windows SFTP 推送（生成的 Excel 推送到 Windows C:\StatsData） ----
# Windows 云主机地址与 SSH 端口（需在 Windows 运行 powershell/setup-sftp-datadrive.ps1）
SFTP_HOST=8.133.223.251
SFTP_PORT=22
SFTP_USERNAME=Administrator
# Linux 服务器上的私钥路径（先用 ssh-keygen -t ed25519 -f ~/.ssh/stats_windows -N '' 生成）
SFTP_KEY_PATH=~/.ssh/stats_windows
# 私钥口令（没有则留空）
SFTP_PASSPHRASE=
# Windows 上的目标目录
WINDOWS_DATA_DIR=C:/StatsData
# 用户个人工作区根目录（管理员按申请生成的数据推送到 {该目录}/{用户名}/，对应用户 W: 盘）
WINDOWS_WORKSPACE_DIR=C:/workspace
