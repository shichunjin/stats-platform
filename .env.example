# ============================================================
# 环境变量配置模板
# 使用方法：复制本文件为 .env 并填入真实值
#   cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿提交到 git
# ============================================================

# ---- 必填（隐私配置，无默认值，缺失会导致启动失败） ----

# 数据库连接串（含密码）
# 示例（PostgreSQL）：postgresql+psycopg2://stats:你的数据库密码@localhost:5432/stats_platform
# 示例（本地开发 SQLite）：sqlite:///./stats_platform.db
DATABASE_URL=postgresql+psycopg2://stats:CHANGE_ME_DB_PASSWORD@localhost:5432/stats_platform

# JWT 签名密钥（请使用足够长的随机字符串）
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_JWT_SECRET

# ---- 可选（以下均有默认值，需要时可覆盖） ----

# 演示账号密码（留空则禁用对应演示账号登录；生产环境建议留空并改用注册账号）
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=

# JWT 算法
JWT_ALGORITHM=HS256

# Token 有效期（小时）
JWT_EXPIRE_HOURS=8

# 文件服务器根路径（后端可写目录；生产环境改为挂载到 Windows 文件服务器的本地路径）
FILESERVER_ROOT=./fileserver_data

# 待导入的原始数据集 CSV 路径
DATASET_CSV_PATH=testData.csv

# 导出免审相似度阈值（0~1）：待导出文件与原始数据集相似度 ≥ 该值转管理员人工审核，
# 低于该值免审核自动发布；默认 0.6 = 60%
EXPORT_REVIEW_SIMILARITY_THRESHOLD=0.6
# 免审自动通过（或人工审核通过）结果的下载有效期（天）
EXPORT_PUBLISH_VALID_DAYS=30

# 数据集名称（导入数据库后的标识）
DATASET_NAME=testData

# 远程桌面服务器地址与端口
RDS_HOST=8.133.223.251
RDS_PORT=3389

# Guacamole 前端地址
GUACAMOLE_URL=https://guac.chunjindevelop68.xyz/guacamole/#/client/

# 兜底共享 RDP 连接 ID：仅在未配置 GUAC_DB_URL（旧 user-mapping 部署）时使用。
# 启用 JDBC 同步后，每个用户使用注册时自动创建的专属连接，此项不再生效。
GUACAMOLE_CONNECTION_ID=1

# Guacamole JDBC 认证数据库连接串（guacamole-auth-jdbc 使用的数据库）
# 配置后：注册时同步创建 Guacamole 用户（同密码）及其“一人一连接”的专属 RDP 连接，
# 修改密码时两边同步更新；留空则不同步（本地开发/测试）。
#
# 部署约定：与平台业务库共用同一个 PostgreSQL 实例，但使用独立 database
#   - 平台库：stats_platform（DATABASE_URL）
#   - Guac 库：guacamole_db（GUAC_DB_URL）
# 分开的原因：Guacamole 升级会重建 guacamole_* 表，独立 database 避免误删业务数据；
# 且 guac 库存有 RDP 连接凭据，需与业务库分别 dump、分别授权。
# 示例（PostgreSQL，同实例独立库）：postgresql+psycopg2://guacamole_user:密码@127.0.0.1:5432/guacamole_db
GUAC_DB_URL=

# ---- 免密直连（Guacamole authToken） ----
# 登录后后端调用 Guacamole REST API 换取令牌，点击「连接数据分析PC」时跳过 Guacamole 登录页。
# API 基址留空时由 GUACAMOLE_URL 推导（即 https://域名/guacamole/api）
GUACAMOLE_API_URL=
# 令牌缓存有效期（秒）：需不大于 Guacamole 的 api-session-timeout，
# 后者由 guacamole/docker-compose.yml 的 API_SESSION_TIMEOUT（分钟，默认 60）控制
GUAC_TOKEN_TTL_SECONDS=3540
# 换取令牌的 HTTP 超时（秒），Guacamole 不可用时不影响平台登录
GUAC_TOKEN_TIMEOUT_SECONDS=3

# ---- 一人一专属 RDP 连接（配置 GUAC_DB_URL 后生效） ----
# 专属连接名前缀，完整连接名 = 前缀 + 用户名
GUAC_CONNECTION_PREFIX=windows-
# 把账号密码写入连接参数实现 RDP 自动登录（要求 Windows 账号与平台账号同名同密码；
# 设为 false 则用户连接时需手输 Windows 凭据）
GUAC_RDP_AUTO_LOGIN=true
# Windows 域名（工作组环境留空）
GUAC_RDP_DOMAIN=
# RDP 安全层：nla / tls / rdp；留空让 guacd 自动协商
GUAC_RDP_SECURITY=nla
# 忽略 RDP 证书错误（自签证书/按 IP 直连环境建议 true）
GUAC_RDP_IGNORE_CERT=true
# guacd 容器内 RDP 虚拟盘根目录（浏览器向远程会话传文件），按用户名建子目录隔离；留空不启用
GUAC_DRIVE_ROOT=
# guacd 容器内会话录像根目录，按用户名建子目录隔离；留空不录像
GUAC_RECORDING_ROOT=

# PowerShell 登录脚本路径（当前单机部署实际由公共启动项调用 C:\stats-scripts\login.ps1，
# 本项仅多机共享部署时使用；后端当前不直接调用）
# 桌面软件清单由登录脚本同目录的 software-registry.json 维护（运维手工部署，平台不参与管理）
PS_LOGIN_SCRIPT=\\fileserver\scripts\login.ps1

# ---- Windows SFTP 推送（生成的 Excel 推送到 Windows C:\StatsData） ----
# Windows 云主机地址与 SSH 端口（需在 Windows 运行 powershell/setup-sftp-datadrive.ps1）
SFTP_HOST=8.133.223.251
SFTP_PORT=22
SFTP_USERNAME=Administrator
# Linux 服务器上的私钥路径（先用 ssh-keygen -t ed25519 -f ~/.ssh/stats_windows -N '' 生成）
SFTP_KEY_PATH=~/.ssh/stats_windows
# 私钥口令（没有则留空）
SFTP_PASSPHRASE=
# Windows 上的目标目录
WINDOWS_DATA_DIR=C:/StatsData
# 用户个人工作区根目录（获取数据/筛选生成都推送到 {该目录}/{用户名}/，对应用户 W: 盘，投递即锁定为本人私有）
WINDOWS_WORKSPACE_DIR=C:/workspace
# 用户结果暂存根目录（{该目录}/{用户名}/，对应 pending 共享；注册时同样按用户锁定）
WINDOWS_PENDING_DIR=C:/pending
# 注册/改密时是否经 SSH 在 Windows 云主机自动创建/更新同名本地账号
# （复用上面 SFTP 的主机与免密私钥；账号会自动加入 Users 与 Remote Desktop Users）
# 本地开发或未启用 OpenSSH 时设 false
WINDOWS_ACCOUNT_SYNC=true
