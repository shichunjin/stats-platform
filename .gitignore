# 构建产物
build/
dist/
*.so

# 虚拟环境（遗留目录，规则保留以免本地 .venv 被误加进暂存区）
.venv/
venv/
env/
ENV/

# 数据库文件（本地运行生成，不入库）
*.db
*.sqlite
*.sqlite3

# 文件服务器数据（本地运行生成）
fileserver_data/

# 测试缓存
coverage/

# IDE
.vscode/
.idea/
.workbuddy/
*.swp
*.swo

# 日志
*.log

# 系统文件
Thumbs.db
.DS_Store

# 环境变量
.env
.env.*
!.env.example
!**/.env.example

# Guacamole（db-data 为运行时 PostgreSQL 数据目录，不入库）
guacamole/db-data/

# Node / TypeScript
node_modules/
*.tsbuildinfo
# dist/ 已在上方全局忽略；这里只补 TS 侧的可选缓存目录
.vitest-cache/
# npm 缓存目录（本地安装时由 npm_config_cache 生成，不入库）
.npm-cache/

# 前端
frontend/node_modules/
frontend/*.local
# dist 构建产物入库（部署机 git pull 后由 Node 服务直接托管；需在全局 dist/ 规则之后取反）
!frontend/dist/
!frontend/dist/**
